{
  "schemaVersion": 1,
  "id": "io.github.jyooi.grammachy",
  "name": "Grammachy",
  "version": "0.3.0",
  "author": "jyooi",
  "license": "MIT",
  "description": "Grammar and spelling checks for any selected text",
  "kinds": [
    "bar-widget",
    "overlay"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Overlay.qml"
  },
  "barWidget": {
    "displayName": "Grammachy",
    "description": "Checks the grammar and spelling of the selected text",
    "category": "Text",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "nativeLanguage": "none",
      "targetEnglish": "en-US",
      "engine": "harper",
      "autoReplace": false
    },
    "schema": [
      {
        "key": "nativeLanguage",
        "type": "string",
        "label": "Native language",
        "options": [
          "none",
          "zh",
          "ms",
          "es",
          "fr",
          "de",
          "pt",
          "ja"
        ],
        "defaultValue": "none"
      },
      {
        "key": "targetEnglish",
        "type": "string",
        "label": "Target English",
        "options": [
          "en-US",
          "en-GB"
        ],
        "defaultValue": "en-US"
      },
      {
        "key": "engine",
        "type": "string",
        "label": "Engine",
        "options": [
          "languagetool",
          "harper"
        ],
        "defaultValue": "harper"
      },
      {
        "key": "autoReplace",
        "type": "boolean",
        "label": "Auto-replace the selection",
        "defaultValue": false
      }
    ]
  }
}
