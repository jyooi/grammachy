  "properties": [
    {
      "name": "CardShows",
      "status": "holds",
      "break": {
        "code": "Overlay.qml beginPrimaryPaste drops the primary read while the clipboard restore runs, and does not set pendingPrimaryPaste",
        "find": "                    THEN /\\ pendingPrimaryPaste' = TRUE",
        "replace": "                    THEN /\\ pendingPrimaryPaste' = FALSE"
      }
    },
    {
      "name": "PasteNeverStrays",
      "status": "holds",
      "break": {
        "code": "Overlay.qml onSourceFocusVerified types the paste without the Anchor.isFocused check",
        "find": "  /\\ IF rc.gen = gen /\\ focus = sourceWindow",
        "replace": "  /\\ IF rc.gen = gen"
      }
    },
    {
      "name": "ClipboardComesBackWithoutStaleRead",
      "status": "holds",
      "break": {
        "code": "Overlay.qml resetRun does not give the borrowed clipboard back",
        "find": "  /\\ restore' = IF clipboardBorrowed /\\ restore.st = \"idle\" THEN RestoreLaunch(borrowed) ELSE restore\n  /\\ clipboardBorrowed' = FALSE\n  /\\ borrowed' = \"\"\n  /\\ phase' = \"capturing\"",
        "replace": "  /\\ restore' = restore\n  /\\ clipboardBorrowed' = FALSE\n  /\\ borrowed' = \"\"\n  /\\ phase' = \"capturing\""
      }
    },
    {
      "name": "ReleaseOnceWithoutStaleRead",
      "status": "holds",
      "break": {
        "code": "Overlay.qml releasePrimary does not clear runCaptured",
        "find": "    THEN /\\ runCaptured' = FALSE\n         /\\ primary' = \"\"",
        "replace": "    THEN /\\ runCaptured' = runCaptured\n         /\\ primary' = \"\""
      }
    },
    {
      "name": "HighlightOutlivesReplaceWithoutEarlyClose",
      "status": "holds",
      "break": {
        "code": "Overlay.qml copyProcess.onExited calls close() before it sets replacePending",
